# Copy this file to .env and fill in your values
# cp .env.example .env

# Database
DB_USERNAME=admin
DB_PASSWORD=your_strong_password_here

# JWT — generate a random 64-char string
JWT_SECRET=your-super-secret-jwt-key-must-be-at-least-256-bits-long-change-this

# CORS — set to your domain in production
CORS_ORIGINS=http://localhost

# AWS S3 (optional — leave blank to disable)
AWS_ACCESS_KEY=
AWS_SECRET_KEY=

# OpenAI (optional — leave blank to disable AI features)
OPENAI_API_KEY=
